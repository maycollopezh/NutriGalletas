{
  "name": "nutrigalletas-administracion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:inventory:db": "node tests/integration/inventory-sql.mjs",
    "test:db": "node tests/integration/sql-validation.mjs",
    "build": "node scripts/build.mjs",
    "test:observations:db": "node tests/integration/observations-sql.mjs",
    "format": "prettier --write src scripts tests supabase/functions index.html package.json",
    "format:check": "prettier --check src scripts tests supabase/functions index.html package.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "prettier": "3.6.2"
  }
}
